# URL base da API (backend Node). O Vite usa isso para proxy de /api em desenvolvimento.
VITE_AUTH_API_URL=https://hub.uniodontopoa.com.br/api/auth/login

# Endpoint de login consumido pelo frontend.
# Valor padrão recomendado em dev: /api/auth/login
VITE_AUTH_API_URL=/api/auth/login

# Endpoint para upload da planilha de faturas e retorno de XLSX com links XML.
# Valor padrão recomendado: /api/financeiro/faturas-links-xlsx
VITE_FINANCEIRO_FATURAS_XLSX_URL=/api/financeiro/faturas-links-xlsx

# Endpoint para obter lista de links em JSON e gerar scripts JS automaticamente.
# Valor padrão recomendado: /api/financeiro/faturas-links-json
VITE_FINANCEIRO_FATURAS_LINKS_JSON_URL=/api/financeiro/faturas-links-json

# Endpoint para gerar pacote ZIP contendo XMLs, links_xml.xlsx e relatórios.
# Valor padrão recomendado: /api/financeiro/faturas-xml-zip
VITE_FINANCEIRO_FATURAS_XML_ZIP_URL=/api/financeiro/faturas-xml-zip

# Observacao: credenciais de banco SQL Server devem ser preenchidas em server/.env
