PORT=3000
CORS_ORIGIN=http://localhost:5173
AUTH_MODE=jwt
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=8h
SESSION_SECRET=troque-esta-chave-em-producao

LDAP_URL=ldap://wfpi1003:389
LDAP_BASE_DN=DC=uniodontopoa,DC=com,DC=br
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_UPN_SUFFIX=uniodontopoa.com.br
LDAP_NETBIOS_DOMAIN=UNIODONTO
LDAP_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))
LDAP_REJECT_UNAUTHORIZED=true

# Login temporario para contingencia local (desabilitar apos ajuste do AD)
TEST_AUTH_ENABLED=false
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=
TEST_AUTH_DISPLAY_NAME=Usuario de Teste Local
TEST_AUTH_EMAIL=teste.local@uniodontopoa.com.br

# SQL Server (consulta financeira de XML por IdFatura)
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERT=true